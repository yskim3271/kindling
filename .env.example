# Copy to .env.local and fill in.

# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID again; this one is sent to the browser to load the PayPal button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# "direct"  -> money goes straight to the writer's PayPal email (payee on the order)
# "platform" -> money lands in the app's own account
PAYPAL_PAYEE_MODE=direct

# --- TypeSafe (the Jev model reads letters for the patron's agent) --------
# https://console.typesafe.ai
TYPESAFE_API_KEY=
